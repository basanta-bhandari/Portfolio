# Copy this file to .env.local and fill in real values.
# .env.local is gitignored - never commit it.

# Bootstrap username for the first super admin. After the first successful
# login, the account is stored in the database and managed from /admin/.
ADMIN_USERNAME=

# Bootstrap password hash for the first super admin (NOT the plain password).
# It is only used when no database-backed super admin exists. Generate with
# Node's built-in crypto module - no npm install needed for this step:
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync('your-password-here',s,64).toString('hex'))"
ADMIN_PASSWORD_HASH=

# A long random string used to sign login sessions. Generate with:
#   openssl rand -hex 32
JWT_SECRET=

# Added automatically to your Vercel project once you connect the Neon
# database from the Storage tab in the Vercel dashboard. For local dev,
# copy the value shown there (or run `vercel env pull .env.local`).
DATABASE_URL=

# Cloudflare R2 blog-image storage. R2_UPLOAD_SECRET must match the Worker
# secret; generate it with: openssl rand -hex 32
R2_UPLOAD_URL=
R2_UPLOAD_SECRET=
R2_PUBLIC_BASE_URL=https://media.basanta.cc

# Encrypted admin chat. R2_CHAT_API_URL is the Worker URL. The API secret must
# match the Worker's CHAT_API_SECRET. The separate 32-byte AES key exists only
# as the Worker's CHAT_ENCRYPTION_KEY secret and must never be added to Vercel.
# Generate each secret independently with: openssl rand -hex 32
R2_CHAT_API_URL=
R2_CHAT_API_SECRET=
